generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id              String         @id @default(uuid())
  name            String
  razorpay_key_id String
  monthly_revenue Decimal        @db.Decimal(12, 2)
  created_at      DateTime       @default(now())

  customers       Customer[]
  payments        Payment[]
  recovery_cases  RecoveryCase[]

  @@map("merchants")
}

model Customer {
  id                  String         @id @default(uuid())
  merchant_id         String
  email               String
  phone               String
  name                String
  contact_count       Int            @default(0)
  last_contacted_at   DateTime?
  recovery_preference String         @default("sms") // email, sms, whatsapp

  merchant            Merchant       @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  payments            Payment[]

  @@map("customers")
}

enum PaymentStatus {
  created
  authorized
  captured
  failed
  refunded
}

enum PaymentMethod {
  upi
  card
  netbanking
  wallet
  emi
}

model Payment {
  id                  String         @id @default(uuid())
  razorpay_payment_id String         @unique
  merchant_id         String
  customer_id         String
  amount              Int            // Amount in paise (INR)
  currency            String         @default("INR")
  status              PaymentStatus
  payment_method      PaymentMethod
  failure_reason      String?
  failure_code        String?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  merchant            Merchant       @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  customer            Customer       @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  recovery_cases      RecoveryCase[]

  @@map("payments")
}

enum CaseStatus {
  pending_analysis
  in_recovery
  recovered
  failed
  escalated
  stopped
}

enum FailureType {
  upi_timeout
  card_decline
  insufficient_funds
  bank_downtime
  network_drop
  subscription_failure
  checkout_abandonment
  overdue_invoice
}

model RecoveryCase {
  id                      String           @id @default(uuid())
  payment_id              String
  merchant_id             String
  status                  CaseStatus       @default(pending_analysis)
  failure_type            FailureType
  recovery_probability    Decimal          @db.Decimal(5, 4) // 0.0000 to 1.0000
  expected_recovery_value Int              // Amount in paise
  ai_reasoning            String?          @db.Text
  recovery_plan           Json?            // JSONB: primary, fallbacks, messages
  amount_recovered        Int              @default(0) // Amount in paise
  attempts_count          Int              @default(0)
  created_at              DateTime         @default(now())
  resolved_at             DateTime?

  payment                 Payment          @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  merchant                Merchant         @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  recovery_actions        RecoveryAction[]
  audit_events            AuditEvent[]

  @@map("recovery_cases")
}

enum ActionType {
  retry_payment
  send_payment_link
  send_sms_nudge
  send_email_nudge
  escalate_human
  mark_stopped
}

enum ActionStatus {
  pending
  executing
  succeeded
  failed
  skipped_by_policy
}

model RecoveryAction {
  id                    String         @id @default(uuid())
  recovery_case_id      String
  action_type           ActionType
  status                ActionStatus   @default(pending)
  razorpay_api_endpoint String?
  razorpay_request      Json?          // JSONB
  razorpay_response     Json?          // JSONB
  policy_check_result   Json?          // JSONB: rules checked, approved/blocked
  executed_at           DateTime?
  outcome_verified_at   DateTime?

  recovery_case         RecoveryCase   @relation(fields: [recovery_case_id], references: [id], onDelete: Cascade)
  audit_events          AuditEvent[]

  @@map("recovery_actions")
}

model AuditEvent {
  id                 String          @id @default(uuid())
  recovery_case_id   String?
  recovery_action_id String?
  event_type         String          // CASE_CREATED, RISK_SCORED, AGENT_DECISION, POLICY_APPROVED, etc.
  event_data         Json            // JSONB: full payload context
  created_at         DateTime        @default(now())
  layer              String          // Layer 0 - Layer 6

  recovery_case      RecoveryCase?   @relation(fields: [recovery_case_id], references: [id], onDelete: SetNull)
  recovery_action    RecoveryAction? @relation(fields: [recovery_action_id], references: [id], onDelete: SetNull)

  @@index([recovery_case_id])
  @@index([created_at])
  @@map("audit_events")
}

model EvaluationRun {
  id                      String   @id @default(uuid())
  run_name                String   // baseline_naive_retry or reclaim_v1_holdout
  total_cases             Int
  recovered_count         Int
  failed_count            Int
  escalated_count         Int
  total_at_risk_amount    BigInt   // Paise
  total_recovered_amount  BigInt   // Paise
  recovery_rate           Decimal  @db.Decimal(5, 4)
  intervention_success_rate Decimal @db.Decimal(5, 4)
  policy_violations       Int      @default(0)
  audit_coverage          Decimal  @default(1.0) @db.Decimal(5, 4)
  created_at              DateTime @default(now())

  @@map("evaluation_runs")
}
