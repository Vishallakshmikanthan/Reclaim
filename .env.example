# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reclaim_db?schema=public"

# Google Gemini Free Tier API Key (Gemini Developer API)
GEMINI_API_KEY="AIzaSyDummyGeminiApiKeyForDemoOnly"
GEMINI_MODEL="gemini-2.5-flash"

# Razorpay Test Mode Credentials (rzp_test_...)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
