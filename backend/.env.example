# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://reclaim:change-me-local@localhost:5432/reclaim"

# Google Gemini Free Tier API Key (Gemini Developer API)
GEMINI_API_KEY="AIzaSyDummyGeminiApiKeyForDemoOnly"
GEMINI_MODEL="gemini-2.5-flash"

# Recovery Provider Selection: "simulated" (default) or "razorpay_test"
RECOVERY_PROVIDER="simulated"

# Razorpay Test Mode Credentials (rzp_test_...) - Backend only, NEVER expose to browser
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourTestKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourTestWebhookSecretHere"

# Backend FastAPI Service URL
NEXT_PUBLIC_API_URL="http://localhost:8000"
FASTAPI_PORT=8000
FASTAPI_HOST="0.0.0.0"

# Node Environment
NODE_ENV="development"

