# ==============================================================================
# RECLAIM - Backend Service Environment Template (backend/.env.example)
# ==============================================================================
# Copy this file to backend/.env for local FastAPI backend execution.
# ALL VARIABLES IN THIS FILE ARE SERVER ONLY - NEVER EXPOSE TO FRONTEND.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SERVER ONLY)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (psycopg 3 driver for SQLAlchemy)
# [REQUIRED FOR POSTGRES BACKEND]
DATABASE_URL="postgresql+psycopg://reclaim:change-me-local@localhost:5432/reclaim"

# Repository backend: "postgres" (default)
REPOSITORY_BACKEND="postgres"

# Default demo merchant identifier
DEMO_MERCHANT_ID="merchant_demo"

# ------------------------------------------------------------------------------
# 2. NVIDIA NEMOTRON AI CONFIGURATION (SERVER ONLY)
# ------------------------------------------------------------------------------
# NVIDIA Build API Key for Nemotron-70B advisory intelligence.
# [OPTIONAL] - If empty/omitted, RECLAIM automatically degrades to DETERMINISTIC_FALLBACK.
# Get an API key from NVIDIA Build: https://build.nvidia.com/
# NEVER prefix with NEXT_PUBLIC_ or expose to client.
NVIDIA_API_KEY=""

# Nemotron model identifier on NVIDIA Build (OpenAI-compatible hosted API)
NVIDIA_NEMOTRON_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# AI Provider mode: "nemotron" (advisory intelligence) | "mock" (offline tests) | "deterministic"
AI_PROVIDER="nemotron"

# Hosted API base URL and request timeout
NVIDIA_API_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_REQUEST_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 3. PAYMENT RECOVERY GATEWAY CONFIGURATION (SERVER ONLY)
# ------------------------------------------------------------------------------
# Recovery Provider mode:
# - "simulated": In-memory simulated payment execution & state transitions (default)
# - "razorpay_test": Real Razorpay Test-Mode execution (strictly rzp_test_*)
RECOVERY_PROVIDER="simulated"

# Razorpay Test Mode Credentials (rzp_test_...)
# [REQUIRED FOR REAL TEST MODE] - NEVER provide live (rzp_live_...) keys.
# Live keys are blocked by strict validation at startup.
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourTestKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourTestWebhookSecretHere"

# ------------------------------------------------------------------------------
# 4. SERVER & NETWORK CONFIGURATION (SERVER ONLY)
# ------------------------------------------------------------------------------
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT=8000
LOG_LEVEL="INFO"
FRONTEND_ORIGIN="http://localhost:3000"
ENVIRONMENT="development"



